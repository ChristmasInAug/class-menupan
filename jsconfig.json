{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "/lib/*": ["./lib/*"]
    }
  },
  "include": [
    "server.mjs",
    "lib/**/*.mjs",
    "public/**/*.js",
    "test/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "public/assets",
    "design",
    "data"
  ]
}
